# Copie para ".env" (não versionado) e ajuste os valores.
# O .env é carregado AUTOMATICAMENTE (pydantic-settings) -- não precisa mais de
# `source .env` na mão.

# ---------- Banco ----------
# Sem DATABASE_URL, a API usa SQLite local (payflow.db) -- bom pra dev rápido.
# Com DATABASE_URL, usa Postgres.
DATABASE_URL=postgresql+psycopg2://payflow:payflow@localhost:5432/payflow

# ---------- Segredos (OBRIGATÓRIOS em produção) ----------
# Gere com:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Gere com:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EMBEDDING_KEY=

# ---------- Admin / Governo ----------
ADMIN_EMAIL=admin@payflow.com.br
# Em produção é obrigatória. Em dev, se vazia, usa uma senha de desenvolvimento
# (com aviso no log).
ADMIN_SENHA=

# ---------- Tokens ----------
ACCESS_TOKEN_EXP_MIN=15
REFRESH_TOKEN_EXP_DIAS=7

# ---------- Split Payment (Reforma Tributária) ----------
# "2026" = alíquotas de teste (CBS 0,9% + IBS 0,1%)
# "2027" = simulação cheia (CBS 8,8% + IBS 17,7%)
SPLIT_VIGENCIA=2026
LIMITE_FACIAL_REAIS=500

# ---------- Segurança ----------
FOTO_MAX_BYTES=5242880
BIOMETRIA_MAX_TENTATIVAS=5
BIOMETRIA_JANELA_MIN=15
LOGIN_MAX_TENTATIVAS=10
LOGIN_JANELA_MIN=15

# ---------- CORS ----------
# Domínios liberados (separados por vírgula). Em produção, só o domínio do front.
CORS_ORIGINS=http://localhost:3000,http://localhost:19006,http://127.0.0.1:5500

# ---------- Ambiente ----------
# "producao" torna JWT_SECRET, EMBEDDING_KEY e ADMIN_SENHA obrigatórios.
AMBIENTE=desenvolvimento
