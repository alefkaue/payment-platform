# Copie para ".env" (não versionado) e preencha. O docker-compose lê este arquivo,
# e o backend (pydantic-settings) também, quando roda fora do Docker.
# Valores marcados OBRIGATÓRIO em produção fazem o boot falhar se faltarem.

# ---------- Banco ----------
POSTGRES_USER=payflow
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=payflow
# Fora do Docker (uvicorn local). Sem DATABASE_URL o backend usa SQLite (payflow.db).
# DATABASE_URL=postgresql+psycopg2://payflow:troque-esta-senha@localhost:5432/payflow

# ---------- Segredos (OBRIGATÓRIO em produção) ----------
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EMBEDDING_KEY=
ADMIN_EMAIL=admin@payflow.com.br
# Em dev, vazio = senha padrão "payflow-admin-dev" (ver README). Em produção é obrigatória.
ADMIN_SENHA=

# ---------- Ambiente ----------
AMBIENTE=desenvolvimento
CORS_ORIGINS=http://localhost:8081,http://localhost:8080,http://localhost:3000
# IPs de proxies/load balancers cujo X-Forwarded-For é confiável (vírgula).
PROXIES_CONFIAVEIS=

# ---------- Modos de teste (proibidos em produção) ----------
# 1 = não chama o DeepFace (aceita qualquer rosto). O desafio continua valendo.
BIOMETRIA_STUB=0
# stub = aceita qualquer CNPJ válido; brasilapi = consulta pública da Receita.
CNPJ_PROVEDOR=stub

# ---------- Regras de negócio (opcionais; padrão entre parênteses) ----------
# LIMITE_FACIAL_REAIS=500
# NOTURNO_HORA_INICIO=20
# NOTURNO_HORA_FIM=6
# DISPOSITIVO_NOVO_POR_TRANSACAO=200
# DISPOSITIVO_NOVO_DIARIO=1000
# LIMITE_CARENCIA_HORAS=24
# RISCO_VALOR_MINIMO=1000
# BLOQUEIO_CAUTELAR_HORAS=72
# CONTESTACAO_PRAZO_DIAS=80
# CDI_ANUAL=0.149
# RENDIMENTO_PERCENTUAL_CDI=1.0
# SPLIT_VIGENCIA=        (ano do simulador; vazio = ano corrente)
