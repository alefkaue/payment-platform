# Copie para ".env" (não versionado) e preencha. O docker-compose lê este arquivo,
# e o backend (pydantic-settings) também, quando roda fora do Docker.
# Com AMBIENTE=producao o boot FALHA se algo marcado OBRIGATÓRIO faltar ou se um
# modo de teste estiver ligado (ver app/core/config.py e SEGURANCA.md item 8).
# No Azure, os segredos vêm do Key Vault (referências no Container Apps), nunca daqui.

# ---------- Banco ----------
# Credenciais bootstrap/migração/runtime ficam no .env.docker (ver exemplo).
# Não coloque POSTGRES_PASSWORD nem DATABASE_MIGRATION_PASSWORD neste arquivo:
# o env_file do serviço backend carrega todo o conteúdo dele.
# DATABASE_URL em produção: usuário astro_app, sslmode=verify-full e sslrootcert.
# DATABASE_URL=postgresql+psycopg2://astro_app:SENHA_URL_ENCODED@HOST:5432/astro?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt

# ---------- Segredos (OBRIGATÓRIO em produção) ----------
# 32+ caracteres: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Chave Fernet: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Trocar a chave invalida as biometrias já cadastradas (cada pessoa refaz o rosto).
EMBEDDING_KEY=
ADMIN_EMAIL=admin@payflow.com.br
# 16+ caracteres em produção. Em dev, vazio = senha padrão "payflow-admin-dev" (ver README).
ADMIN_SENHA=
# Admin de operação não tem biometria: em produção só entra destes IPs (vírgula).
# Vazio em produção = login de admin desligado.
ADMIN_IPS_PERMITIDOS=
# 2º fator do admin: segredo TOTP em base32 (160+ bits) para o app autenticador.
# Obrigatório em produção se ADMIN_IPS_PERMITIDOS estiver preenchido. Gerar:
#   python -c "import base64,secrets;print(base64.b32encode(secrets.token_bytes(20)).decode())"
ADMIN_TOTP_SEGREDO=

# ---------- Ambiente ----------
AMBIENTE=desenvolvimento
# Origens exatas do app (vírgula). Em produção: só https, sem "*".
CORS_ORIGINS=http://localhost:8081,http://localhost:8080,http://localhost:3000
# Regex de origens: só para desenvolvimento; PROIBIDO em produção.
# CORS_ORIGIN_REGEX=
# IPs ou faixas CIDR de proxies/load balancers cujo X-Forwarded-For é confiável (vírgula).
# No Azure: a sub-rede da API (infra/azure/main.bicep).
PROXIES_CONFIAVEIS=
# Azure Front Door: id do perfil (X-Azure-FDID). Quando bate, o IP do cliente vem de
# X-Azure-ClientIP. Vazio = sem Front Door.
FRONT_DOOR_ID=

# ---------- Atestação do aparelho (APK Android, SEGURANCA.md item 10) ----------
# Pacote do app e SHA-256 (hex) do certificado que assina o APK release
# (sai no resumo do workflow "Build APK"). Vazio = não confere a assinatura.
# ATESTACAO_PACOTE=com.payflow.app
# ATESTACAO_ASSINATURAS=
# 1 = login só com chave atestada em hardware (desliga web/PWA).
# ATESTACAO_EXIGIDA=0
# Lista de revogação da Google; vazio = não confere.
# ATESTACAO_STATUS_URL=https://android.googleapis.com/attestation/status
# Swagger em /docs: ligado em dev, desligado em produção (1 religa).
# DOCS_HABILITADOS=

# ---------- Modos de teste (PROIBIDOS em produção: o boot falha) ----------
# 1 = não roda a análise facial (aceita qualquer rosto). O desafio continua valendo.
BIOMETRIA_STUB=0
# stub = aceita qualquer CNPJ válido; brasilapi = consulta pública da Receita.
CNPJ_PROVEDOR=stub
# auto = Tesseract se instalado, senão análise humana; tesseract; sem_ocr; stub (aceita o declarado).
DOCUMENTO_PROVEDOR=auto
# 0 = cadastro sem foto do documento.
KYC_DOCUMENTO_OBRIGATORIO=1
# 1 = POST /pagamentos/depositar-demo cria dinheiro de teste.
DEPOSITO_DEMO=0
# 0 = aceita token sem prova de posse da chave (DPoP).
DPOP_OBRIGATORIO=1

# ---------- Sessão e autenticação (padrão entre parênteses) ----------
# JWT_ALGORITMO=HS256
# JWT_ISSUER=astro-api
# JWT_AUDIENCE=astro-app
# ACCESS_TOKEN_EXP_MIN=15
# REFRESH_TOKEN_EXP_DIAS=7
# MFA_TOKEN_EXP_MIN=5          (senha ok, falta o rosto)
# SESSAO_MAX_HORAS=12          (máximo desde o login com senha + rosto)
# SESSAO_INATIVIDADE_MIN=30    (refresh sem uso)
# DPOP_JANELA_SEG=60           (tolerância de relógio da prova DPoP)
# SENHA_MIN=10

# ---------- Força bruta e limites por IP (padrão entre parênteses) ----------
# LOGIN_MAX_TENTATIVAS=10      (falhas por conta a partir do MESMO IP: trava esse IP)
# LOGIN_MAX_TENTATIVAS_CONTA=50 (falhas por conta somando todos os IPs: trava a conta)
# LOGIN_MAX_TENTATIVAS_IP=30
# LOGIN_JANELA_MIN=15
# CADASTRO_MAX_IP_HORA=10
# RECUPERACAO_MAX_IP_HORA=10   (pedidos de recuperação de senha por IP)
# RECUPERACAO_MAX_CONTA_HORA=5 (pedidos de recuperação por conta, de qualquer IP)
# RECUPERACAO_TOKEN_EXP_MIN=10 (tempo para concluir a recuperação com o rosto)
# REFRESH_MAX_IP_15MIN=120
# CONSULTA_CHAVE_MAX_HORA=60
# BIOMETRIA_MAX_TENTATIVAS=5
# BIOMETRIA_JANELA_MIN=15

# ---------- Biometria e documentos (padrão entre parênteses) ----------
# BIOMETRIA_MOTOR=opencv       (opencv | deepface)
# MODELOS_DIR=                 (vazio = ~/.cache/astro/modelos)
# MODELOS_DOWNLOAD=1           (0 em produção: os modelos vêm na imagem)
# FACE_LIMIAR_COSSENO=0.42
# FACE_DOC_LIMIAR_COSSENO=0.30
# ANTISPOOF_LIMIAR=0.5
# BIOMETRIA_CONCORRENCIA=2
# BIOMETRIA_ESPERA_SEG=10
# DESAFIO_VALIDADE_SEG=120
# FOTO_MAX_BYTES=5242880
# DOCUMENTO_MAX_BYTES=6291456
# EMPRESA_DOCUMENTO_MAX_BYTES=10485760

# ---------- Regras de negócio (padrão entre parênteses) ----------
# LIMITE_FACIAL_REAIS=500
# NOTURNO_HORA_INICIO=20
# NOTURNO_HORA_FIM=6
# DISPOSITIVO_NOVO_POR_TRANSACAO=200
# DISPOSITIVO_NOVO_DIARIO=1000
# LIMITE_CARENCIA_HORAS=24
# RISCO_VALOR_MINIMO=1000
# BLOQUEIO_CAUTELAR_HORAS=72
# CONTESTACAO_PRAZO_DIAS=80
# LIMITE_DUAS_APROVACOES_REAIS=250000   (empresa grande: assinatura conjunta acima disto, inclusive admin)
# PENDENTE_VALIDADE_HORAS=72            (operação pendente sem decisão expira)
# PENDENTE_EXECUTANDO_MIN=10            (aprovada e presa em executando: o job concilia)
# MEI_MAX_FUNCIONARIOS=1
# CDI_ANUAL=0.149
# RENDIMENTO_PERCENTUAL_CDI=1.0
# SPLIT_VIGENCIA=        (ano do simulador; vazio = ano corrente)
# Transição honesta do split (LC 214/2025): antes desta data a cobrança mostra o imposto
# da nota, mas NÃO retém (2026 é ano de teste). Padrão: 2027-01-01.
# SPLIT_RETENCAO_DESDE=2027-01-01
# Só para apresentação: retém antes da data, com selo de simulação no app. Proibido em produção.
# SPLIT_DEMONSTRACAO=0
# BENEFICIOS_HABILITADOS=0     (Loja/Viagens/pontos arquivados; 1 religa)

# ---------- Webhooks (padrão entre parênteses) ----------
# WEBHOOK_TIMEOUT_SEG=5
# WEBHOOK_MAX_TENTATIVAS=5
# WEBHOOK_ENTREGA_IMEDIATA=1

# Só desenvolvimento: 0 exige rosto real nos novos cadastros mesmo com login demo.
# Vazio/ausente segue BIOMETRIA_STUB. Produção proíbe qualquer stub.
# BIOMETRIA_STUB_CADASTRO=0
