# Copie para ".env" (não versionado) e ajuste os valores.
# Sem essa variável definida, a API cai automaticamente pro repositório em
# memória (comportamento de antes) -- nenhuma mudança de código necessária
# pra continuar testando sem Postgres.

DATABASE_URL=postgresql+psycopg2://payflow:payflow@localhost:5432/payflow
