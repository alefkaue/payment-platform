# Copie para ".env" ao lado do docker-compose.yml (NÃO versionado) e preencha.
# O docker compose lê este arquivo automaticamente.

# ---- Postgres ----
POSTGRES_USER=payflow
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=payflow

# ---- Segredos da API (gere valores fortes) ----
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EMBEDDING_KEY=

# ---- Admin / Governo ----
ADMIN_EMAIL=admin@payflow.com.br
ADMIN_SENHA=troque-esta-senha-admin

# ---- App ----
SPLIT_VIGENCIA=2026
LIMITE_FACIAL_REAIS=500
CORS_ORIGINS=http://localhost:3000
AMBIENTE=producao
