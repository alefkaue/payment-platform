# Modelo dos segredos do stack LOCAL por imagens do Docker Hub (docker-compose.hub.yml).
# NÃO coloque segredos reais aqui -- este arquivo VAI pro git.
# Jeito fácil: rode ./gerar-segredos.sh (gera um .env.docker completo e aleatório).
# Manual: copie para .env.docker e preencha. O .env.docker é ignorado pelo git.
POSTGRES_USER=payflow
POSTGRES_DB=payflow
POSTGRES_PASSWORD=troque-me
DATABASE_APP_PASSWORD=troque-me
DATABASE_MIGRATION_PASSWORD=troque-me
JWT_SECRET=troque-me-32-caracteres-ou-mais
ADMIN_SENHA=troque-me-16-caracteres-ou-mais
# Chaves Fernet (base64 urlsafe, 32 bytes) -- cada uma DIFERENTE das outras:
#   openssl rand -base64 32 | tr '+/' '-_'
EMBEDDING_KEY=troque-me
WEBHOOK_KEYS=troque-me
PII_KEYS=troque-me
PII_INDEX_KEY=troque-me
DATABASE_CONTEXT_KEY=troque-me
