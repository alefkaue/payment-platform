# cp .env.docker.example .env.docker
# Use senhas DIFERENTES, geradas com secrets.token_urlsafe(32).
# Para senhas com caracteres reservados, a URL requer percent-encoding.
POSTGRES_USER=payflow
POSTGRES_DB=payflow
POSTGRES_PASSWORD=
DATABASE_MIGRATION_PASSWORD=
DATABASE_APP_PASSWORD=
# docker compose --env-file .env.docker up --build
# A configuração da API/segredos JWT fica no .env; estas senhas NÃO devem ir nele.

# Chaves independentes, geradas fora do Git; compartilhadas só entre migrador e API.
WEBHOOK_KEYS=
PII_KEYS=
PII_INDEX_KEY=
DATABASE_CONTEXT_KEY=

# Origem exata acessada pelo app quando usar a API do Compose.
DOCKER_API_ORIGEM=http://127.0.0.1:8000
DOCKER_HTTP_HOSTS=localhost,127.0.0.1
