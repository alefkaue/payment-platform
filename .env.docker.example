# cp .env.docker.example .env.docker
# Use senhas DIFERENTES, geradas com secrets.token_urlsafe(32).
# Para senhas com caracteres reservados, a URL requer percent-encoding.
POSTGRES_USER=payflow
POSTGRES_DB=payflow
POSTGRES_PASSWORD=
DATABASE_MIGRATION_PASSWORD=
DATABASE_APP_PASSWORD=
# docker compose --env-file .env.docker up --build
# A configuração da API/segredos JWT fica no .env; estas senhas NÃO devem ir nele.
