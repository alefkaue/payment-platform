# Variante HTTPS de produção para Azure Students; o Dockerfile local é preservado.
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL}
RUN npm run build && sed -i 's/ async=""//g' dist/client/_shell.html \
    && node scripts/cabecalhos.mjs && node scripts/assemble-www.mjs \
    && node scripts/nginx-config.mjs

FROM nginxinc/nginx-unprivileged:stable-alpine
COPY --from=build /app/www /usr/share/nginx/html
COPY --from=build /app/nginx-students.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
USER 101
