<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nada do app vai para o backup na nuvem nem para outro aparelho.
     Sessão e chave são deste aparelho (a chave do Keystore nem pode sair dele). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
