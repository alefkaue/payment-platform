<?xml version="1.0" encoding="utf-8"?>
<!--
  Astro Lab (só para o pentest): aceita a CA instalada pelo usuário (Burp/ZAP) e NÃO tem
  certificate pinning, para os grupos lerem o tráfego e atacarem a lógica da API.
  O app "Astro" (endurecido) usa src/main/res/xml/network_security_config.xml + pinning.
  Continua só HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
