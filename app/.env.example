# URL do backend FastAPI. Sem ela, o app roda no modo demonstração (mocks).
# Ex.: VITE_API_URL=http://localhost:8000
VITE_API_URL=

# Build de produção (npm run build) SEM VITE_API_URL é recusado, para um deploy
# esquecido não sair em modo demonstração (qualquer login entra). Para gerar uma
# demonstração de propósito, descomente:
# VITE_MODO_DEMO=1
